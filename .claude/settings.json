{
  "permissions": {
    "deny": [
      "Bash(git init *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "PowerShell(git init *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git pull *)",
      "PowerShell(git merge *)",
      "PowerShell(git checkout -b *)",
      "PowerShell(git switch -c *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.mjs\"",
            "timeout": 180,
            "statusMessage": "lint とビルドを実行中"
          }
        ]
      }
    ]
  }
}
