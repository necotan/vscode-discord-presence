{
  "name": "vscode-discord-presence",
  "displayName": "Discord Presence",
  "description": "Show your VS Code activity on Discord",
  "publisher": "necotan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/necotan/vscode-discord-presence.git"
  },
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Discord Presence",
      "properties": {
        "discordPresence.enabled": {
          "type": "boolean",
          "default": true,
          "order": 0,
          "description": "Show your VS Code activity on Discord."
        },
        "discordPresence.clientId": {
          "type": "string",
          "default": "",
          "order": 1,
          "description": "Client ID (Application ID) of the Discord application. Leave empty to use the built-in one."
        },
        "discordPresence.showFileName": {
          "type": "boolean",
          "default": true,
          "order": 2,
          "description": "Show the name of the file you are editing."
        },
        "discordPresence.showLanguage": {
          "type": "boolean",
          "default": true,
          "order": 3,
          "description": "Show the language name and icon."
        },
        "discordPresence.showWorkspace": {
          "type": "boolean",
          "default": true,
          "order": 4,
          "description": "Show the workspace name."
        },
        "discordPresence.idleTimeoutMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "order": 5,
          "description": "Minutes after VS Code loses focus before showing Idling. 0 shows it immediately."
        }
      }
    },
    "commands": [
      {
        "command": "discordPresence.reconnect",
        "title": "Reconnect",
        "category": "Discord Presence"
      },
      {
        "command": "discordPresence.toggle",
        "title": "Toggle",
        "category": "Discord Presence"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "generate:icons": "node scripts/generateIcons.mjs",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.144.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
